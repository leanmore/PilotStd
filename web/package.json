{
  "name": "web",
  "private": true,
  "version": "0.37.18",
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc -p tsconfig.app.json --noEmit",
    "test": "npx vitest run",
    "test:native": "node --import tsx/esm --import ./src/test-env.ts --test src/stores/app.native-test.ts",
    "prepare": "cd .. && git config core.hooksPath .husky 2>/dev/null || true"
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.5",
    "axios": "^1.16.1",
    "grid-layout-plus": "^1.1.1",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.34",
    "vue-i18n": "^11.4.6",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "rollup-plugin-visualizer": "^7.0.1",
    "ts-prune": "^0.10.3",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.2.8"
  }
