# PilotStd 环境变量配置模板
# 复制为 .env 后修改实际值，.env 不会被 git 追踪

# API 静态令牌（Docker 容器 + 压测脚本共用）
# 设置后在 Docker 中自动写入 api_keys 表（key_id='pst_static'）
# 压测脚本 stress_web.py 通过 os.getenv("PILOTSTD_API_TOKEN") 读取
PILOTSTD_API_TOKEN=

# Docker 连接信息（压测脚本使用）
# PILOTSTD_BASE_URL=http://192.168.1.18:9028
# PILOTSTD_USERNAME=
# PILOTSTD_PASSWORD=

# 超级用户账号（可选，默认 admin）
SUPERUSER=admin

# 超级用户初始密码（可选，不填则自动生成随机密码，输出到容器日志）
# 首次启动生效，初始化后不再生效（用户登录后自行修改）
# SUPERUSER_PASSWORD=your_password
