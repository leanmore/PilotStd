# PilotStd 环境变量配置模板
# 复制为 .env 后修改实际值，.env 不会被 git 追踪

# API 静态令牌（Docker 容器 + 压测脚本共用）
# 设置后在 Docker 中自动写入 api_keys 表（key_id='pst_static'）
# 压测脚本 stress_web.py 通过 os.getenv("PILOTSTD_API_TOKEN") 读取
PILOTSTD_API_TOKEN=

# Docker 部署凭证（可选，未设置则首次启动自动生成）
# JWT_SECRET=
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Docker 连接信息（压测脚本使用）
# PILOTSTD_BASE_URL=http://192.168.1.18:9028
# PILOTSTD_USERNAME=
# PILOTSTD_PASSWORD=

# Docker 自更新开关：true=每次启动拉取最新镜像, false=关闭
PILOTSTD_AUTO_UPDATE=false

# Docker 镜像名称（默认即可，如需指定版本可修改 tag）
PILOTSTD_IMAGE=ghcr.io/leanmore/pilotstd:latest
